{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./web/spec/*"]
    }
  },
  "include": ["src", "factory", "web"]
}
