#!/usr/bin/env bash
# dev - the factory engine.
#
# A task is a markdown file. The directory it sits in is its state, and a state
# change is one atomic `mv`, so builders claim work without a lock. Builders
# work in their own branch and worktree. The integrator is the only writer to
# origin/main and lands one branch at a time.
set -euo pipefail

ROOT=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
F=${FACTORY_HOME:-$ROOT.factory}
SELF=$(readlink -f "$0")

: "${FACTORY_BUILDERS:=2}"
: "${FACTORY_ATTEMPTS:=2}"                  # agent tries per build before a bounce
: "${FACTORY_MAX_BOUNCES:=3}"               # bounces before a task is parked in stuck/
: "${FACTORY_QUEUE:=5}"                     # ready tasks the scout tops up to
: "${FACTORY_FAST:=(\.md$|^docs/)}"         # a diff of only these paths takes the fast lane
: "${FACTORY_RISKY:=^(factory/|\.github/)}" # a diff touching these paths is reviewed
: "${FACTORY_EVERY:=21600}"                 # seconds between loop runs; 4 runs a day

declare -A STAGES=(
  [normal]="compile fmt guard test"
  [fast]="fmt guard"
  [fix]="fmt full"
)

TRANSITIONS=" ready:building building:submitted building:ready building:stuck submitted:landed submitted:ready submitted:stuck "

mkdir -p "$F"/tasks/{ready,building,submitted,landed,stuck} "$F"/{wt,log,locks,ids}

# --- helpers ---------------------------------------------------------------

log() { echo "$(date -u +%H:%M:%S) $*" | tee -a "$F/log/factory.log" >&2; }
die() {
  log "fatal: $*"
  exit 1
}

task_file() { ls "$F"/tasks/*/"$1".md; }
task_state() { basename "$(dirname "$(task_file "$1")")"; }
meta() { sed -n "1,/^---\$/s/^$2: //p" "$(task_file "$1")"; } # id key -> value

set_meta() { # id key value
  local f
  f=$(task_file "$1")
  if [ -n "$(meta "$1" "$2")" ]; then
    sed -i "1,/^---\$/s|^$2: .*|$2: $3|" "$f"
  else
    sed -i "0,/^---\$/s|^---\$|$2: $3\n---|" "$f"
  fi
}

move() { # id from to
  [[ $TRANSITIONS == *" $2:$3 "* ]] || die "illegal transition $2 -> $3 for $1"
  mv "$F/tasks/$2/$1.md" "$F/tasks/$3/$1.md" 2>/dev/null
}

# Builders, the integrator and after-checks share one set of remote-tracking
# refs, and concurrent fetches into it fail with "cannot lock ref".
fetch() { flock "$F/locks/fetch" git -C "$ROOT" fetch -q origin; }

fresh_wt() { # path ref -> a detached worktree, replacing one a killed run left
  git -C "$ROOT" worktree remove --force "$1" 2>/dev/null || true
  git -C "$ROOT" worktree add -q --detach "$1" "$2"
}

new_id() {
  local n=1
  until mkdir "$F/ids/$(printf 'b%04d' $n)" 2>/dev/null; do n=$((n + 1)); done
  printf 'b%04d' $n
}

# The task file is the handoff between attempts and sessions. Its "## Record"
# section stays last and holds one line per fact the engine verified; full
# output lives in a log the line points to.
record() { # id line
  local f
  f=$(task_file "$1")
  grep -qx '## Record' "$f" || printf '\n## Record\n' >>"$f"
  echo "- $(date -u +%m-%dT%H:%MZ) $2" >>"$f"
}

save_fail() { # id output -> path of a new log holding the full output
  local n
  n=$(($(find "$F/log" -name "$1-fail*.log" | wc -l) + 1))
  printf '%s\n' "$2" >"$F/log/$1-fail$n.log"
  echo "$F/log/$1-fail$n.log"
}

latest_fail() { ls -v "$F/log/$1"-fail*.log 2>/dev/null | tail -1; } # id -> path

summarize() { # full output on stdin -> the few lines a reader needs first
  local all
  all=$(cat)
  grep -m12 -E 'error|Error|FAIL|\(fail\)|✗|Expected|Received|Conflict|failed at stage' <<<"$all" || tail -12 <<<"$all"
}

waiting_on() { # task-file -> dependencies that have not landed, space separated
  local d
  for d in $(sed -n '1,/^---$/s/^after: //p' "$1" 2>/dev/null); do
    [ -e "$F/tasks/landed/$d.md" ] || printf '%s ' "$d"
  done
}

add_task() { # title owner culprit after < body -> id
  local id body
  body=$(cat)
  grep -q '^## Done when' <<<"$body" || die "task '$1' has no '## Done when' section"
  id=$(new_id)
  {
    echo "title: $1"
    [ -z "$2" ] || echo "owner: $2"
    [ -z "$3" ] || echo "culprit: $3"
    [ -z "${4:-}" ] || echo "after: $4"
    echo "bounces: 0"
    echo "---"
    echo "$body"
  } >"$F/tasks/$id.tmp"
  mv "$F/tasks/$id.tmp" "$F/tasks/ready/$id.md"
  log "$id ready: $1"
  echo "$id"
}

bounce() { # id from reason fail-log -> back to its builder, or stuck after too many
  local n=$(($(meta "$1" bounces) + 1)) to=ready
  set_meta "$1" bounces "$n"
  [ "$n" -lt "$FACTORY_MAX_BOUNCES" ] || to=stuck
  record "$1" "bounce $n to $to: $3 (log: $4)"
  move "$1" "$2" "$to"
  log "$1 bounced to $to ($n): $3"
}

# ponytail: a crash between the claiming mv and set_meta leaves an ownerless
# task in building/. Move it back to ready/ by hand; add a reaper if it recurs.
claim() { # builder -> id. Order: own unfinished build, own ready, unowned ready.
  local f id owner
  for f in "$F"/tasks/building/*.md; do
    [ -e "$f" ] || continue
    id=$(basename "$f" .md)
    [ "$(meta "$id" owner)" = "$1" ] && echo "$id" && return
  done
  for want in "$1" ""; do
    for f in "$F"/tasks/ready/*.md; do
      [ -e "$f" ] || continue
      id=$(basename "$f" .md)
      owner=$(sed -n '1,/^---$/s/^owner: //p' "$f" 2>/dev/null) || continue
      [ "$owner" = "$want" ] || continue
      [ -z "$(waiting_on "$f")" ] || continue
      move "$id" ready building || continue # lost the race
      set_meta "$id" owner "$1"
      record "$id" "claimed by $1"
      echo "$id"
      return
    done
  done
  return 1
}

# The gate always runs main's copy of the checks, so a branch cannot land by
# weakening its own gate. A change to checks.sh takes effect one landing later.
trusted_checks() {
  CHECKS=$(mktemp)
  trap 'rm -f "$CHECKS"' EXIT
  fetch
  git -C "$ROOT" show origin/main:factory/checks.sh >"$CHECKS"
}

lane() { # id -> fix | fast | normal, from the task and the diff in cwd
  if [ -n "$(meta "$1" culprit)" ]; then
    echo fix
  elif git diff --name-only origin/main...HEAD | grep -qvE "$FACTORY_FAST"; then
    echo normal
  else
    echo fast
  fi
}

gate() { # id -> runs the lane's stages in cwd; fmt is applied and folded into HEAD
  local stage l
  l=$(lane "$1")
  log "$1 lane=$l stages=${STAGES[$l]}"
  for stage in ${STAGES[$l]}; do
    bash "$CHECKS" "$stage" origin/main || {
      echo "failed at stage $stage"
      return 1
    }
    if [ "$stage" = fmt ]; then
      git add -A
      git diff --cached --quiet || git commit -q --amend --no-edit || return 1
    fi
  done
}

news() { # fail-log -> what changed since the agent last looked, for any prompt
  [ ! -e "$(git rev-parse --git-dir)/MERGE_HEAD" ] ||
    echo "A merge of origin/main is in progress with conflicts. Resolve them and keep both intents."
  [ -z "$1" ] || printf 'The factory rejected your last attempt. Key lines:\n%s\nFull output: %s (search it; do not print it whole)\n' \
    "$(summarize <"$1")" "$1"
}

builder_prompt() { # id builder fail-log -> everything a fresh session needs
  cat <<EOF
You are builder $2 in a software factory. Do exactly one task in this git worktree.

Task $1: $(meta "$1" title)

$(sed '1,/^---$/d' "$(task_file "$1")")

Rules:
- Change only what the task needs.
- Run the task's "Done when" command and make it pass.
- Commit on the current branch. Do not push. Do not switch branches.
- Put each decision you made and why in the commit message body, one line each. Earlier
  attempts' decisions are in \`git log origin/main..HEAD\`.
- Read logs and code with targeted searches and line ranges, not whole files.
$(news "$3")
EOF
}

# Sessions, when AGENT_NEW_SESSION (prints a session ref) and AGENT_RESUME ({}
# is the ref) are set. Every session the factory opens is appended to
# $F/sessions as "<ref> <label>", so a coordinator with thread tools can nest
# it under itself; the CLI cannot. Sessions are never closed here: a ticket's
# thread stays as its visible record until a person archives it.
new_session() { # label -> ref
  local s
  s=$($AGENT_NEW_SESSION | tail -1)
  [ -n "$s" ] || die "AGENT_NEW_SESSION printed no session for $1"
  echo "$s $1" >>"$F/sessions"
  echo "$s"
}

one_shot() { # label resume-template cold-command prompt -> the agent's reply
  local s
  if [ -z "$2" ]; then
    $3 "$4"
  else
    s=$(new_session "$1")
    ${2//\{\}/$s} "$4"
  fi
}

# One agent session per task, from first claim until it lands or sticks;
# without sessions every attempt starts cold with $AGENT. A resumed session
# already holds the task, so it gets only the news.
run_agent() { # id builder fail-log attempt
  local s prompt
  if [ -z "${AGENT_RESUME:-}" ]; then
    set -- "$@" $AGENT
    prompt=$(builder_prompt "$1" "$2" "$3")
  else
    s=$(meta "$1" session)
    if [ -z "$s" ]; then
      s=$(new_session "$1")
      set_meta "$1" session "$s"
      prompt=$(builder_prompt "$1" "$2" "$3")
    else
      prompt="Task $1 again, same worktree. $(news "$3")
Fix it, run Done when, and commit."
    fi
    set -- "$@" ${AGENT_RESUME//\{\}/$s}
  fi
  FACTORY_TASK_FILE=$(task_file "$1") FACTORY_ATTEMPT=$4 "${@:5}" "$prompt"
}

# Start `dev <cmd> <sha> ...` in the background holding a lock that `drain`
# waits on. The lock is taken before the fork so drain cannot miss it.
spawn() { # cmd sha [args]
  exec 8>"$F/locks/$1-$2"
  flock 8
  ("$SELF" "$@" >>"$F/log/$1-$2.log" 2>&1) 9>&- &
  exec 8>&-
}

# --- commands --------------------------------------------------------------

cmd_task() { # add <title> [--owner b] [--culprit sha] [--after id,id] < body
  [ "${1:-}" = add ] && [ -n "${2:-}" ] || die "usage: dev task add <title> [--owner b] [--culprit sha] [--after id,id] < body"
  local title=$2 owner="" culprit="" after=""
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) owner=$2 ;;
      --culprit) culprit=$2 ;;
      --after) after=${2//,/ } ;;
      *) die "unknown flag $1" ;;
    esac
    shift 2
  done
  add_task "$title" "$owner" "$culprit" "$after"
}

cmd_build() { # builder
  local b=${1:?usage: dev build <builder>} id wt base attempt out fail=""
  : "${AGENT:?set AGENT to your agent command, e.g. AGENT='amp -x'}"
  exec 7>"$F/locks/builder-$b"
  flock -n 7 || die "builder $b is already running"
  id=$(claim "$b") || {
    log "$b: nothing to build"
    return 0
  }
  trusted_checks
  wt=$F/wt/$id
  if [ ! -d "$wt" ]; then
    base=origin/main
    # A normal task starts from the last green main so it does not inherit a
    # red. A fix task starts from main, because that is where the culprit is.
    if [ -z "$(meta "$id" culprit)" ] && git -C "$ROOT" rev-parse -q --verify origin/main-green >/dev/null; then
      base=origin/main-green
    fi
    git -C "$ROOT" worktree add -q -B "task/$id" "$wt" "$base"
  fi
  cd "$wt"
  if [ "$(meta "$id" bounces)" != 0 ]; then
    git merge -q --no-edit origin/main >/dev/null 2>&1 || true
    fail=$(latest_fail "$id")
  fi
  for attempt in $(seq "$FACTORY_ATTEMPTS"); do
    log "$id $b: agent attempt $attempt"
    run_agent "$id" "$b" "$fail" "$attempt" >>"$F/log/$id.log" 2>&1 7>&- || true
    git add -A
    git diff --cached --quiet || git commit -qm "$id: $(meta "$id" title)"
    if [ "$(git rev-list --count origin/main..HEAD)" = 0 ]; then
      out="The branch has no commits ahead of origin/main."
    elif out=$(gate "$id" 2>&1); then
      cmd_submit "$id"
      return 0
    fi
    fail=$(save_fail "$id" "$out")
    record "$id" "attempt $attempt by $b failed: $(summarize <"$fail" | head -1) (log: $fail)"
    log "$id $b: proof failed (attempt $attempt)"
  done
  bounce "$id" building "builder proof failed" "$fail"
}

cmd_submit() { # id
  record "$1" "proof passed at $(git rev-parse --short HEAD)"
  touch "$(task_file "$1")" # submit time orders the integrator queue
  move "$1" building submitted || die "$1 is not building"
  log "$1 submitted"
}

land() { # id, in the integrator worktree
  local id=$1 sha files out
  fetch
  git reset -q --hard # first: a crash mid-merge leaves an index checkout refuses
  git clean -qfd
  git checkout -q --detach origin/main
  if ! git merge-base --is-ancestor "task/$id" HEAD; then # else: pushed before a crash
    if ! git merge -q --no-ff -m "merge task/$id: $(meta "$id" title)" "task/$id" >/dev/null 2>&1; then
      files=$(git diff --name-only --diff-filter=U | tr '\n' ' ')
      git merge --abort
      bounce "$id" submitted "Conflict with origin/main in: ${files% }" \
        "$(save_fail "$id" "Conflict with origin/main in: $files")"
      return 0
    fi
    if ! out=$(gate "$id" 2>&1); then
      bounce "$id" submitted "Integrator gate failed after merging origin/main" "$(save_fail "$id" "$out")"
      return 0
    fi
    git push -q origin HEAD:main || die "push to origin/main failed; $id stays submitted"
  fi
  sha=$(git rev-parse HEAD)
  record "$id" "landed $sha"
  set_meta "$id" landed "$sha"
  move "$id" submitted landed
  git -C "$ROOT" worktree remove --force "$F/wt/$id" 2>/dev/null || true
  git -C "$ROOT" branch -qD "task/$id"
  log "$id landed $sha"
  spawn after "$sha" "$id"
  spawn review "$sha" "$id"
}

cmd_integrate() {
  local wt=$F/wt/_integrator id
  exec 9>"$F/locks/integrator"
  flock -n 9 || {
    log "integrator already running"
    return 0
  }
  trusted_checks
  [ -d "$wt" ] || git -C "$ROOT" worktree add -q --detach "$wt" origin/main
  cd "$wt"
  while id=$(ls -tr "$F/tasks/submitted" | head -1) && [ -n "$id" ]; do
    land "${id%.md}"
  done
}

# Full gate on one commit of main. Green moves origin/main-green forward.
# Red files one task naming the culprit and never blocks a landing.
cmd_after() { # sha [task-id]
  local sha=$1 id=${2:-} wt=$F/wt/_after-$1 out parent culprit owner=""
  fresh_wt "$wt" "$sha"
  cd "$wt"
  if out=$(bash factory/checks.sh full 2>&1); then
    # No force: the push is fast-forward only, so main-green never moves back.
    git push -q origin "$sha:refs/heads/main-green" 2>/dev/null || true
    log "main green at $sha"
  else
    parent=$(git rev-parse "$sha^1")
    [ ! -e "$F/locks/after-$parent" ] || flock "$F/locks/after-$parent" true
    fetch
    exec 6>"$F/locks/red"
    flock 6
    if grep -lqs '^culprit: ' "$F"/tasks/{ready,building,submitted,stuck}/*.md; then
      log "main red at $sha, already tracked by an open main-red task"
    else
      culprit="unknown, first seen at $sha"
      ! git merge-base --is-ancestor "$parent" origin/main-green 2>/dev/null || culprit=$sha
      [ -z "$id" ] || owner=$(meta "$id" owner)
      add_task "main red after ${sha:0:9}" "$owner" "$culprit" <<EOF >/dev/null
main is red. Culprit: $culprit${id:+ (task $id: $(meta "$id" title))}.
Fix forward on top of origin/main.

## Done when
\`bash factory/checks.sh full\` passes.

## Failure
$(tail -40 <<<"$out")
EOF
    fi
  fi
  cd "$ROOT"
  git worktree remove --force "$wt"
}

cmd_gate() { # the scheduled full gate: check whatever main is now
  local sha
  fetch
  sha=$(git -C "$ROOT" rev-parse origin/main)
  exec 8>"$F/locks/after-$sha" # the lock a spawned after holds: never two on one sha
  flock 8
  cmd_after "$sha"
}

# Review after landing, only for a risky or retried change. Findings become a
# task for the builder that wrote the change.
cmd_review() { # sha task-id
  local sha=$1 id=$2 out
  [ -n "${REVIEWER:-}" ] || return 0
  [ "$(meta "$id" bounces)" != 0 ] ||
    git -C "$ROOT" diff --name-only "$sha^1" "$sha" | grep -qE "$FACTORY_RISKY" || return 0
  log "$id review of $sha"
  out=$(one_shot "review $id" "${REVIEWER_RESUME:-}" "$REVIEWER" "Review this landed change as a skeptic. Report only real bugs, each with a failing case.
If there are none, reply with exactly LGTM on its own line.

$(git -C "$ROOT" diff "$sha^1" "$sha" | head -c 60000)")
  if grep -qx 'LGTM' <<<"$out"; then
    record "$id" "review of ${sha:0:9} clean"
    log "$id review clean"
    return 0
  fi
  local fix
  fix=$(add_task "review findings for $id" "$(meta "$id" owner)" "" <<EOF
Review of ${sha:0:9} (task $id: $(meta "$id" title)) found problems. Fix them on a new branch.

$out

## Done when
Each finding above has a test that fails before your fix and passes after.
EOF
  )
  record "$id" "review of ${sha:0:9} found problems: $fix"
}

# Top the ready queue up to FACTORY_QUEUE. The agent proposes; `task add`
# rejects anything without a "Done when" section.
cmd_scout() {
  : "${AGENT:?set AGENT to your agent command}"
  local have wt=$F/wt/_scout
  have=$(find "$F/tasks/ready" -name '*.md' | wc -l)
  [ "$have" -lt "$FACTORY_QUEUE" ] || return 0
  exec 5>"$F/locks/scout"
  flock -n 5 || return 0 # another scout is filling the same queue
  fetch
  fresh_wt "$wt" origin/main
  (
    cd "$wt"
    one_shot scout "${AGENT_RESUME:-}" "$AGENT" "You are the scout of a software factory. Propose $((FACTORY_QUEUE - have)) tasks for this repository.
Read factory/sources.md for where to look. Each task must fit in one commit and have a
'## Done when' section with a command that fails today. Do not edit any file.
Create each task by running this, with every line starting in column 1:
$SELF task add '<title>' <<'TASK'
<what to do and why>

## Done when
\`<command>\` passes.
TASK
Skip anything already tracked:
$(grep -hs '^title: ' "$F"/tasks/*/*.md)" >>"$F/log/scout.log" 2>&1 5>&- || true
  )
  git -C "$ROOT" worktree remove --force "$wt"
  exec 5>&- # builders started after the scout must not hold its lock
}

cmd_drain() { # wait for every after and review run still in flight
  local f
  for f in "$F"/locks/after-* "$F"/locks/review-*; do
    [ ! -e "$f" ] || flock "$f" true
  done
}

# What a coordinator needs and nothing more: outcomes, dependencies and where
# to look. Landings older than a day are only counted.
cmd_status() {
  local s f id extra recent old=0
  fetch
  recent=$(git -C "$ROOT" log --since=24.hours --merges --format=%H origin/main)
  echo "main       $(git -C "$ROOT" rev-parse --short origin/main)"
  echo "main-green $(git -C "$ROOT" rev-parse --short -q --verify origin/main-green || echo none)"
  for s in ready building submitted stuck landed; do
    for f in "$F/tasks/$s"/*.md; do
      [ -e "$f" ] || continue
      id=$(basename "$f" .md)
      extra=""
      if [ "$s" = landed ]; then
        grep -q "$(meta "$id" landed)" <<<"$recent" || {
          old=$((old + 1))
          continue
        }
        extra=" | $(meta "$id" landed | cut -c1-9)"
      fi
      [ -z "$(waiting_on "$f")" ] || extra+=" | waits on $(waiting_on "$f")"
      [ "$(meta "$id" bounces)" = 0 ] || extra+=" | bounces $(meta "$id" bounces), last log $(latest_fail "$id")"
      [ -z "$(meta "$id" culprit)" ] || extra+=" | culprit $(meta "$id" culprit | cut -c1-9)"
      printf '%-10s %s  %s%s\n' "$s" "$id" "$(sed -n '1s/^title: //p' "$f")" "$extra"
    done
  done
  echo "landed     $old more before the last 24 hours; details in $F/tasks/<state>/<id>.md"
}

cmd_run() { # one loop: scout, build in parallel, land serially, check, report
  local i
  cmd_scout
  for i in $(seq "$FACTORY_BUILDERS"); do "$SELF" build "b$i" & done
  wait
  "$SELF" integrate
  cmd_drain
  cmd_status
}

# The schedule: a run, then the full gate, every FACTORY_EVERY seconds. Keep it
# under a supervisor, e.g. `amp orb service start factory --command 'factory/dev loop'`.
cmd_loop() {
  while :; do
    "$SELF" run || log "run failed"
    "$SELF" gate || log "gate failed"
    sleep "$FACTORY_EVERY"
  done
}

cmd=${1:-status}
shift || true
case "$cmd" in
  task | build | submit | integrate | after | gate | review | scout | drain | status | run | loop) "cmd_$cmd" "$@" ;;
  *) die "unknown command: $cmd" ;;
esac
