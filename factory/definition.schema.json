{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory project definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capacity",
    "workerModel",
    "prd",
    "tickets",
    "scope",
    "verify",
    "permissions"
  ],
  "properties": {
    "version": { "const": 1 },
    "capacity": { "enum": [1, 2] },
    "lightWorker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "pattern": "^[^/]+/.+$" },
        "effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "pattern": "^[^/]+/.+$" },
        "effort": {
          "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
        }
      }
    },
    "mode": { "type": "string", "minLength": 1 },
    "workerModel": { "type": "string", "pattern": "^[^/]+/.+$" },
    "workerRunner": { "type": "string", "pattern": "\\S" },
    "workerEffort": {
      "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "orchestratorModel": { "type": "string", "pattern": "^[^/]+/.+$" },
    "review": { "type": "boolean" },
    "providerLimit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "wait" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "reviewerModel"],
          "properties": {
            "mode": { "const": "fallback" },
            "reviewerModel": {
              "type": "string",
              "pattern": "^[^\\s/]+/[^\\s]+$"
            },
            "workerModel": { "type": "string", "pattern": "^[^\\s/]+/[^\\s]+$" }
          }
        }
      ]
    },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspicionMs", "spendingFirstAttempt", "spendingInterval"],
      "properties": {
        "suspicionMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1800000
        },
        "disconnectMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 180000
        },
        "spendingFirstAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 6
        },
        "spendingInterval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 4
        }
      }
    },
    "prd": { "type": "string", "minLength": 1 },
    "tickets": { "type": "string", "minLength": 1 },
    "ticketFiles": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verify": { "type": "string", "minLength": 1 },
    "setup": { "type": "string", "minLength": 1 },
    "setupTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "bookkeepingSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execute", "publish", "externalTickets"],
      "properties": {
        "execute": { "type": "boolean" },
        "publish": { "const": false },
        "externalTickets": { "const": false },
        "backup": { "type": "boolean" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "projectKey"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*/[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "projectKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
        }
      }
    }
  },
  "dependentRequired": { "setupTimeoutMs": ["setup"] },
  "if": { "properties": { "capacity": { "const": 2 } } },
  "then": { "required": ["lightWorker"] },
  "else": { "not": { "required": ["lightWorker"] } }
}
