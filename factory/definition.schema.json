{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory project definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capacity",
    "workerModel",
    "prd",
    "tickets",
    "scope",
    "verify",
    "permissions"
  ],
  "properties": {
    "version": { "const": 1 },
    "capacity": { "const": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "workerModel": { "type": "string", "pattern": "^[^/]+/.+$" },
    "workerEffort": {
      "enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]
    },
    "orchestratorModel": { "type": "string", "pattern": "^[^/]+/.+$" },
    "review": { "type": "boolean" },
    "watchdog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspicionMs", "spendingFirstAttempt", "spendingInterval"],
      "properties": {
        "suspicionMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 1800000
        },
        "spendingFirstAttempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 6
        },
        "spendingInterval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 4
        }
      }
    },
    "prd": { "type": "string", "minLength": 1 },
    "tickets": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verify": { "type": "string", "minLength": 1 },
    "setup": { "type": "string", "minLength": 1 },
    "setupTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "bookkeepingSHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execute", "publish", "externalTickets"],
      "properties": {
        "execute": { "type": "boolean" },
        "publish": { "const": false },
        "externalTickets": { "const": false },
        "backup": { "type": "boolean" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "projectKey"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*/[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "projectKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
        }
      }
    }
  },
  "dependentRequired": { "setupTimeoutMs": ["setup"] }
}
