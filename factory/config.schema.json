{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory config directory v1",
  "description": "Per-file settings under factory/config/. The loader composes them into the flat object that definition.schema.json describes. Each file's setting names must be listed here. factory.yaml needs verify exactly when checks/ is absent.",
  "$defs": {
    "factory.yaml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "capacity",
        "prd",
        "tickets",
        "scope",
        "permissions"
      ],
      "properties": {
        "version": {
          "$ref": "definition.schema.json#/properties/version"
        },
        "capacity": {
          "$ref": "definition.schema.json#/properties/capacity"
        },
        "mode": {
          "$ref": "definition.schema.json#/properties/mode"
        },
        "prd": {
          "$ref": "definition.schema.json#/properties/prd"
        },
        "tickets": {
          "$ref": "definition.schema.json#/properties/tickets"
        },
        "ticketFiles": {
          "$ref": "definition.schema.json#/properties/ticketFiles"
        },
        "scope": {
          "$ref": "definition.schema.json#/properties/scope"
        },
        "verify": {
          "$ref": "definition.schema.json#/properties/verify"
        },
        "permissions": {
          "$ref": "definition.schema.json#/properties/permissions"
        },
        "backup": {
          "$ref": "definition.schema.json#/properties/backup"
        },
        "bookkeepingSHA256": {
          "$ref": "definition.schema.json#/properties/bookkeepingSHA256"
        },
        "watchdog": {
          "$ref": "definition.schema.json#/properties/watchdog"
        },
        "providerLimit": {
          "$ref": "definition.schema.json#/properties/providerLimit"
        }
      }
    },
    "agents/foreman/agent.md": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "definition.schema.json#/properties/orchestratorModel"
        }
      }
    },
    "agents/implementer/agent.md": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": {
          "$ref": "definition.schema.json#/properties/workerModel"
        },
        "effort": {
          "$ref": "definition.schema.json#/properties/workerEffort"
        },
        "runner": {
          "$ref": "definition.schema.json#/properties/workerRunner"
        }
      }
    },
    "agents/light-implementer/agent.md": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": {
          "$ref": "definition.schema.json#/properties/lightWorker/properties/model"
        },
        "effort": {
          "$ref": "definition.schema.json#/properties/lightWorker/properties/effort"
        }
      }
    },
    "agents/reviewer/agent.md": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "runners/<name>.yaml": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setup": {
          "$ref": "definition.schema.json#/properties/setup"
        },
        "setupTimeoutMs": {
          "$ref": "definition.schema.json#/properties/setupTimeoutMs"
        }
      }
    },
    "checks/<name>.yaml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "order"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": true },
        "timeoutMs": { "type": "integer", "minimum": 1, "default": 600000 },
        "order": { "type": "integer", "minimum": 1 },
        "capability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "versionArgs", "coverage"],
          "properties": {
            "tool": { "type": "string", "pattern": "\\S" },
            "versionArgs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "\\S" }
            },
            "coverage": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "\\S" }
            }
          }
        }
      }
    },
    "agents/observer/agent.md": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": {
          "$ref": "definition.schema.json#/properties/observer/properties/model"
        },
        "effort": {
          "$ref": "definition.schema.json#/properties/observer/properties/effort"
        }
      }
    },
    "automations/<name>/automation.md": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule"],
      "properties": {
        "schedule": {
          "type": "string",
          "description": "Five-field UTC cron: minute hour day-of-month month day-of-week. Quote it in YAML."
        },
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Authored default; the control override wins until the next reload changes this value."
        }
      }
    }
  }
}
